<Window x:Class="DocChange.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DocChange"
        Width="750"
        Height="650"
        MinWidth="650"
        MinHeight="550"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- TITLE -->

        <TextBlock
            Grid.Row="0"
            Text="DocChange"
            FontSize="40"
            FontWeight="Bold"
            HorizontalAlignment="Center"
            Margin="0,0,0,30"/>


        <!-- INPUT FOLDER -->

        <Grid
            Grid.Row="1"
            Margin="0,0,0,15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="Thư mục đầu vào"
                FontWeight="Bold"
                FontSize="14"
                VerticalAlignment="Center"/>

            <TextBox
                Grid.Column="1"
                x:Name="InputFolderTextBox"
                Height="40"
                Padding="10"
                FontSize="14"
                IsReadOnly="True"/>

            <Button
                Grid.Column="2"
                x:Name="InputBrowseButton"
                Content="Chọn"
                Height="40"
                Margin="10,0,0,0"
                FontSize="14"
                Click="InputBrowseButton_Click"/>

        </Grid>


        <!-- OUTPUT FOLDER -->

        <Grid
            Grid.Row="2"
            Margin="0,0,0,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="Thư mục đầu ra"
                FontWeight="Bold"
                FontSize="14"
                VerticalAlignment="Center"/>

            <TextBox
                Grid.Column="1"
                x:Name="OutputFolderTextBox"
                Height="40"
                Padding="10"
                FontSize="14"
                IsReadOnly="True"/>

            <Button
                Grid.Column="2"
                x:Name="OutputBrowseButton"
                Content="Chọn"
                Height="40"
                Margin="10,0,0,0"
                FontSize="14"
                Click="OutputBrowseButton_Click"/>

        </Grid>


        <!-- REPLACEMENT AREA -->

        <GroupBox
    Grid.Row="3"
    FontSize="14"
    Margin="0,0,0,20">

            <GroupBox.Header>

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                Grid.Column="0"
                Text="Nội dung cần thay đổi"
                FontWeight="Bold"
                VerticalAlignment="Center"/>

                    <Button
                Grid.Column="1"
                x:Name="AddReplacementButton"
                Content="+"
                Width="30"
                Height="30"
                FontSize="20"
                FontWeight="Bold"
                Padding="0"
                Click="AddReplacementButton_Click"/>

                </Grid>

            </GroupBox.Header>


            <Grid Margin="10">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <!-- HEADER -->

                <Grid
            Grid.Row="0"
            Margin="0,0,0,10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>


                    <TextBlock
                Grid.Column="0"
                Text="Nội dung cũ"
                FontWeight="Bold"
                HorizontalAlignment="Center"/>


                    <TextBlock
                Grid.Column="2"
                Text="Nội dung mới"
                FontWeight="Bold"
                HorizontalAlignment="Center"/>

                </Grid>


                <!-- LIST -->

                <ScrollViewer
            Grid.Row="1"
            x:Name="ReplacementScrollViewer"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

                    <StackPanel
                x:Name="ReplacementPanel"/>

                </ScrollViewer>

            </Grid>

        </GroupBox>


        <!-- CHECK BUTTON -->

        <Button
            Grid.Row="4"
            x:Name="CheckButton"
            Content="KIỂM TRA"
            Width="180"
            Height="45"
            HorizontalAlignment="Center"
            FontSize="20"
            FontWeight="Bold"
            Margin="0,0,0,10"
            Click="CheckButton_Click"/>


        <!-- STATUS -->

        <Grid
    Grid.Row="5"
    Margin="0,0,0,15">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <TextBlock
        Grid.Row="0"
        x:Name="StatusText"
        Text="Trạng thái: Chưa kiểm tra"
        HorizontalAlignment="Center"
        FontSize="14"/>


            <Button
        Grid.Row="1"
        x:Name="DetailsButton"
        Content="XEM CHI TIẾT"
        Width="140"
        Height="35"
        FontSize="14"
        Margin="0,8,0,0"
        HorizontalAlignment="Center"
        Visibility="Collapsed"
        Click="DetailsButton_Click"/>

        </Grid>


        <!-- EXECUTE -->

        <Button
            Grid.Row="6"
            x:Name="ExecuteButton"
            Content="THỰC HIỆN"
            Width="180"
            Height="45"
            HorizontalAlignment="Center"
            FontSize="20"
            FontWeight="Bold"
            Margin="0,0,0,20"
            Click="ExecuteButton_Click"/>


        <!-- FOOTER -->

        <Grid
            Grid.Row="7"
            Margin="0,10,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="v1.0"
                FontSize="14"
                VerticalAlignment="Bottom"/>

            <TextBlock
                Grid.Column="1"
                Text="Tool created by Nguyen Duc Anh"
                FontSize="14"
                VerticalAlignment="Bottom"/>

        </Grid>

    </Grid>

</Window>